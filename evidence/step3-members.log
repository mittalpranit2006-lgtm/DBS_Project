SQL> -- M1.3 complex multi-table join and aggregation; collected rent, not accrued revenue
SQL> PROMPT M1.3 - collected rent by branch
M1.3 - collected rent by branch
SQL> SELECT b.Branch_Name, b.Location, SUM(p.Amount) AS Collected_Rent
  2    FROM PAYMENT p JOIN RENTAL r ON r.Rental_ID=p.Rental_ID
  3  	    JOIN VEHICLE v ON v.Vehicle_ID=r.Vehicle_ID
  4  	    JOIN BRANCH b ON b.Branch_ID=v.Branch_ID
  5   WHERE p.Payment_Status='Completed' AND r.Status_Name<>'Cancelled'
  6   GROUP BY b.Branch_Name,b.Location ORDER BY Collected_Rent DESC;

