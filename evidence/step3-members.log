SQL> -- M3.4 derived duration and late days; neither is stored
SQL> PROMPT M3.4 - derived billable and late days
M3.4 - derived billable and late days
SQL> SELECT Rental_ID,Status_Name,
  2  	    CASE WHEN Status_Name='Cancelled' THEN 0 ELSE
  3  	      GREATEST(1,CEIL(CAST(COALESCE(Actual_Return_Date,Expected_Return_Date) AS DATE)
  4  			      -CAST(Start_Date AS DATE))) END AS Billable_Days,
  5  	    CASE WHEN Status_Name='Completed' THEN
  6  	      GREATEST(0,CEIL(CAST(Actual_Return_Date AS DATE)-CAST(Expected_Return_Date AS DATE)))
  7  	      WHEN Status_Name='Active' THEN
  8  	      GREATEST(0,CEIL(CAST(SYSTIMESTAMP AS DATE)-CAST(Expected_Return_Date AS DATE)))
  9  	      ELSE 0 END AS Late_Days,
 10  	    Total_Amount FROM RENTAL ORDER BY Rental_ID;

